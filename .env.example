# .env —— 示例用通义千问（OpenAI 兼容接口）

# 模型
IVC_MODEL_NAME=qwen-max
IVC_MODEL_PROVIDER=openai
IVC_API_KEY=replace-with-your-model-api-key
IVC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 连接弹性
IVC_MAX_RETRIES=3
IVC_TIMEOUT=60

# 持久化底座（与 compose.local.yml 一致）
IVC_POSTGRES_URL=postgresql://forgeflow:local-demo-password@127.0.0.1:5432/forgeflow
IVC_DATABASE_URL=postgresql://forgeflow:local-demo-password@127.0.0.1:5432/forgeflow
IVC_REDIS_URL=redis://localhost:6379/0

# 运行
IVC_LOG_LEVEL=INFO

# LangSmith 追踪配置
IVC_LANGSMITH_TRACING=false
IVC_LANGSMITH_API_KEY=
IVC_LANGSMITH_PROJECT=forgeflow

# Docker sandbox and RAG (install vectorstore extra).
IVC_SANDBOX_PROVIDER=docker
IVC_SANDBOX_IMAGE=forgeflow-sandbox:latest
IVC_SANDBOX_WORKDIR=/home/agent
IVC_SANDBOX_RUNTIME=runc
IVC_RAG_ENABLED=true
IVC_EMBEDDING_MODEL=text-embedding-v3
# Optional example:
# IVC_MCP_SERVERS={"example":{"transport":"http","url":"http://127.0.0.1:9000/mcp"}}

# Optional gateway keys: supply your own secret keys; no built-in credentials.
IVC_GATEWAY_API_KEYS={}
# Production compose only: set a private password and use matching database URLs.
# IVC_PG_PASSWORD=replace-with-a-strong-private-password
